<%- include('../partials/layout-start', {
  title: `Checkout — ${settings.store.name || 'Store'}`, css: '/css/checkout.css', script: '/js/checkout.js', announcement: null,
  active: 'cart', cartCount: cartCount, canonical: typeof canonical !== 'undefined' ? canonical : undefined
}) %>
<% const checkoutCopy=settings.content?.storefrontPages?.checkout||{}; const checkoutPaymentMethods=settings.payments.checkoutMethods||[]; const checkoutFields=settings.checkout.fields; %>
<div class="page-hero" style="--page-hero-start:#1b3e28;--page-hero-middle:#254d34;--page-hero-end:#1a3a25;">
  <div class="page-hero-content"><div class="page-hero-eyebrow"><%= checkoutCopy.eyebrow || 'SECURE CHECKOUT' %></div><h1 class="page-hero-title"><%= checkoutCopy.heading || 'Complete your order' %></h1><p class="page-hero-desc"><%= checkoutCopy.description || 'Add your delivery information and review your order.' %></p></div>
</div>
<div class="breadcrumb"><a href="/cart">Cart</a><span class="sep">›</span><span class="current">Checkout</span></div>
<div class="trust-bar"><div class="trust-item"><span class="trust-icon">🔒</span> Guest Checkout</div><div class="trust-item"><span class="trust-icon">🌍</span> Delivery Information</div><div class="trust-item"><span class="trust-icon">📦</span> Order Confirmation</div><div class="trust-item"><span class="trust-icon">✓</span> Order Support</div></div>
<div class="checkout-container">
  <div class="checkout-form-section"><form id="checkoutForm" onsubmit="submitOrder(event)">
    <div class="form-block"><h3 class="form-block-title">Customer Information</h3>
      <div class="form-row"><div class="form-group"><label class="form-label">First Name <span class="required">*</span></label><input class="form-input" type="text" name="firstName" placeholder="<%= checkoutFields.firstName.placeholder %>" required maxlength="80"/></div><div class="form-group"><label class="form-label">Last Name <span class="required">*</span></label><input class="form-input" type="text" name="lastName" placeholder="<%= checkoutFields.lastName.placeholder %>" required maxlength="80"/></div></div>
      <div class="form-row"><div class="form-group"><label class="form-label">Phone <span class="required">*</span></label><input class="form-input" type="tel" name="phone" placeholder="<%= checkoutFields.phone.placeholder %>" required maxlength="50"/></div><div class="form-group"><label class="form-label">Email <span class="optional">(Optional)</span></label><input class="form-input" type="email" name="email" placeholder="<%= checkoutFields.email.placeholder %>" maxlength="254"/></div></div>
    </div>
    <div class="form-block"><h3 class="form-block-title">Address Details</h3><div class="form-group"><label class="form-label">Address <span class="required">*</span></label><input class="form-input" type="text" name="address" placeholder="<%= checkoutFields.address.placeholder %>" required maxlength="500"/></div><div class="form-row"><div class="form-group"><label class="form-label">City <span class="required">*</span></label><input class="form-input" type="text" name="city" placeholder="<%= checkoutFields.city.placeholder %>" required maxlength="100"/></div><div class="form-group"><label class="form-label">Postal Code <span class="optional">(Optional)</span></label><input class="form-input" type="text" name="postalCode" placeholder="<%= checkoutFields.postalCode.placeholder %>" maxlength="30"/></div></div><div class="form-group"><label class="form-label">State / Region <span class="optional">(Optional)</span></label><input class="form-input" type="text" name="state" placeholder="<%= checkoutFields.state.placeholder %>" maxlength="100"/></div></div>
    <div class="form-block"><h3 class="form-block-title">Delivery Instructions (Optional)</h3><div class="form-group"><label class="form-label">Order Notes <span class="optional">(Optional)</span></label><textarea class="form-textarea" name="instructions" placeholder="<%= checkoutFields.instructions.placeholder %>" maxlength="1000"></textarea></div></div>
    <div class="form-block"><div class="form-agreement"><input type="checkbox" id="agreeTerms" name="agreeTerms" required/><label for="agreeTerms">I agree to the <a href="/policies#shipping-policy">Shipping Policy</a>, <a href="/policies#return-policy">Return Policy</a>, <a href="/policies#privacy-policy">Privacy Policy</a>, and <a href="/policies#terms-conditions">Terms & Conditions</a> <span class="required">*</span></label></div></div>
    <div class="checkout-error" id="checkoutError" role="alert" aria-live="polite" hidden></div><button type="submit" class="place-order-btn"><%= checkoutCopy.placeOrderLabel || 'Place Order' %></button><p class="form-security-note">🔒 Basic guest checkout. No online payment details are collected.</p>
  </form></div>
  <div class="order-summary-section"><h3 class="summary-title"><%= checkoutCopy.summaryHeading || 'Order Summary' %></h3><div class="summary-items" id="checkoutSummaryItems"></div><div class="summary-divider"></div><div class="summary-row"><span>Subtotal</span><span id="checkoutSubtotal"><%= formatMoney(0,settings) %></span></div><div class="summary-row"><span>Shipping</span><span id="checkoutShipping" style="color:var(--gold);font-weight:600;">Free</span></div><div class="summary-divider"></div><div class="summary-row summary-total"><span>Total</span><span id="checkoutTotal"><%= formatMoney(0,settings) %></span></div>
    <div class="payment-methods" data-has-payment-methods="true"><h4 class="payment-title">Payment Method</h4><% checkoutPaymentMethods.forEach(function(method,index){ %><div class="payment-option"><input type="radio" id="payment-<%= method.id %>" name="payment" value="<%= method.id %>" <%= index===0?'checked':'' %>/><label for="payment-<%= method.id %>"><div class="payment-label-text"><div style="font-weight:600;"><%= method.label %></div><div style="font-size:.8rem;color:var(--text-lt);"><%= method.description %></div></div></label></div><% }); %></div>
  </div>
</div>
<%- include('../partials/layout-end', { script: '/js/checkout.js' }) %>
